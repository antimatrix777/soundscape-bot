# Copy this file to .env and fill the values locally.
# Do not commit real API keys or OAuth tokens.

GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
TOGETHER_API_KEY=
FAL_API_KEY=
STABLE_HORDE_KEY=

# Audio source. The pipeline defaults to CC0/public-domain-only audio.
FREESOUND_API_KEY=
AUDIO_LICENSE_MODE=cc0_only
ALLOW_YTDLP_FALLBACK=0

PEXELS_API_KEY=
PIXABAY_API_KEY=

# YouTube OAuth Token generated by step5_upload.py --auth-only.
# Prefer GitHub Secrets for this value.
YT_TOKEN_B64=
YT_PRIVACY_STATUS=public

PLAYLIST_RAIN=
PLAYLIST_JAZZ=
PLAYLIST_LOFI=
